{
  "name": "intel-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collect and AI-analyze news from global media sources",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm exec --prefix .. -- eslint \"src/**/*.ts\"",
    "collect": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.8.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
